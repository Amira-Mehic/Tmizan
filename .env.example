# Primjer konfiguracije okruzenja.
# Prekopirati u .env i upisati stvarne vrijednosti iz Supabase Dashboard
# (Project Settings, API). Sam .env se ne postavlja na repozitorij.
#
# Obje varijable se ugraduju u build klijentske aplikacije. Anonimni kljuc smije
# biti javno vidljiv jer pristup podacima ogranicavaju sigurnosna pravila baze
# (Row Level Security), a ne tajnost kljuca.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
